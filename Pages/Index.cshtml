@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Hur är läget?</h1>
</div>

<form method="post">
<label for="Gårdsnamn">Välj här:</label>

<input list="Gårdar" id="GårdId" name="GårdsNamn" placeholder="Eller sök här">

<datalist id="GårdID">
@foreach (var gård in Model.GårdId)
{
    <option value="@gård"></option>
}

</datalist>
</form>
